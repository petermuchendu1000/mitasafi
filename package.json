{
  "name": "mitasafi-web",
  "version": "0.1.0",
  "private": true,
  "description": "Mitasafi - Kenya's trusted rental platform connecting tenants with verified homes and honest landlords",
  "author": "Mitasafi Team",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:supabase": "npx ts-node scripts/test-supabase-connection.ts",
    "db:gen-types": "npx supabase gen types typescript --project-id syoolvgoaqnckgmngvse > src/types/database.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
