# ===========================================
# MITASAFI ENVIRONMENT VARIABLES TEMPLATE
# ===========================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control
# ===========================================

# -------------------------------------------
# SUPABASE CONFIGURATION
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# -------------------------------------------
# GOOGLE SERVICES
# -------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-api-key

# -------------------------------------------
# APPLICATION SETTINGS
# -------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Mitasafi
NEXT_PUBLIC_APP_ENV=development

# -------------------------------------------
# M-PESA DARAJA API (SI-4)
# -------------------------------------------
# Register at https://developer.safaricom.co.ke to get credentials.
# See docs/MPESA_SETUP.md for full setup instructions.
#
# ENVIRONMENT:
#   "sandbox"    — uses sandbox.safaricom.co.ke (default)
#   "production" — uses api.safaricom.co.ke (requires Go-Live approval)
MPESA_ENVIRONMENT=sandbox

# Consumer key and secret from your Daraja app dashboard.
# Sandbox: These are the well-known Safaricom sandbox test values.
#          Replace with your own app credentials from the Daraja portal.
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret

# Lipa Na M-Pesa Online passkey — provided in your Safaricom test credentials.
# Sandbox passkey: bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_PASSKEY=your-passkey

# Business shortcode (paybill number or till number).
# Sandbox shortcode: 174379
MPESA_SHORTCODE=your-shortcode

# Public HTTPS callback URL where Safaricom sends payment confirmations.
# Must be accessible from the internet — cannot use localhost.
# Format: https://your-domain.vercel.app/api/payments/mpesa/callback
# For local development, use a tunnel service (e.g., ngrok):
#   ngrok http 3000 → https://xxxx.ngrok.io/api/payments/mpesa/callback
MPESA_CALLBACK_URL=https://your-domain.vercel.app/api/payments/mpesa/callback

# -------------------------------------------
# AFRICA'S TALKING SMS
# -------------------------------------------
AT_API_KEY=your-api-key
AT_USERNAME=your-username
AT_SENDER_ID=MITASAFI

# -------------------------------------------
# EMAIL (SENDGRID)
# -------------------------------------------
SENDGRID_API_KEY=your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@mitasafi.co.ke

# -------------------------------------------
# MONITORING
# -------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
