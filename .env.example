# ===========================================
# MITASAFI ENVIRONMENT VARIABLES TEMPLATE
# ===========================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local. See docs/SETUP_STATUS_2026-11-03.md for the
# verified stack and where each value comes from.
# ===========================================

# -------------------------------------------
# SUPABASE  (database, auth, storage, realtime)
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
SUPABASE_PROJECT_ID=your-project-id

# -------------------------------------------
# GOOGLE OAUTH  (social login — handled by Supabase)
# -------------------------------------------
# The client SECRET is stored in the Supabase dashboard (Auth > Providers > Google),
# NOT in app env. Set the client id below only if you add Google One-Tap client-side.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# -------------------------------------------
# MAPS + GEOCODING  (Mapbox)
# -------------------------------------------
# Public (pk.) token — safe in the browser. Add a URL restriction before launch.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token
# NOTE: address autocomplete is migrating from Google Places to Mapbox Search Box.

# -------------------------------------------
# APPLICATION SETTINGS
# -------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Mitasafi
NEXT_PUBLIC_APP_ENV=development

# Shared secret guarding the cron endpoint (/api/cron/search-alerts).
CRON_SECRET=your-random-cron-secret

# -------------------------------------------
# PAYMENTS — PayHero (M-Pesa aggregator)
# -------------------------------------------
# Decision: PayHero replaces direct Daraja. NOTE: account is shared with other
# projects — namespace every Mitasafi transaction (unique external_reference +
# dedicated callback) or use a separate channel/account.
# Base URL: https://backend.payhero.co.ke/api/v2
PAYHERO_API_USERNAME=your-payhero-username
PAYHERO_API_PASSWORD=your-payhero-password
PAYHERO_ACCOUNT_ID=your-payhero-account-id
PAYHERO_CHANNEL_ID=your-payhero-channel-id
PAYHERO_BASIC_AUTH=Basic your-base64-username-colon-password

# -------------------------------------------
# PAYMENTS — M-Pesa Daraja (LEGACY — code still references these)
# -------------------------------------------
# Kept until the PayHero port lands. Register at https://developer.safaricom.co.ke
# MPESA_ENVIRONMENT=sandbox        # sandbox | production
# MPESA_CONSUMER_KEY=your-consumer-key
# MPESA_CONSUMER_SECRET=your-consumer-secret
# MPESA_PASSKEY=your-passkey
# MPESA_SHORTCODE=your-shortcode
# MPESA_CALLBACK_URL=https://mitasafi.com/api/payments/mpesa/callback

# -------------------------------------------
# EMAIL  (Resend)
# -------------------------------------------
# Sending domain mitasafi.com is verified (DKIM + SPF). Region: eu-west-1.
RESEND_API_KEY=re_your-resend-key

# -------------------------------------------
# RATE LIMITING / KV  (Upstash Redis — REST)
# -------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# -------------------------------------------
# SMS  (Africa's Talking)
# -------------------------------------------
# SMS_ENABLED=true to send real SMS; anything else = dev/console mode.
SMS_ENABLED=false
AT_API_KEY=your-api-key
AT_USERNAME=your-username
AT_SENDER_ID=MITASAFI

# -------------------------------------------
# AI IMAGE GENERATION  (Cloudflare Workers AI — free)
# -------------------------------------------
# Replaces Kling/Recraft. Used server-side / by scripts/generate-services-images.mjs.
# Models: @cf/black-forest-labs/flux-2-dev (minimal), @cf/leonardo/phoenix-1.0 (detailed).
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# -------------------------------------------
# MONITORING  (optional — not yet configured)
# -------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
# NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
